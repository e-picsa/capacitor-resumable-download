{
  "name": "@picsa/capacitor-resumable-download",
  "version": "0.0.1",
  "description": "Capacitor plugin for robust, resumable file downloads with HTTP Range support, WorkManager background execution, and pause/resume capabilities.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    }
  },
  "files": [
    "android/",
    "dist/",
    "package.json"
  ],
  "author": "e-PICSA",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-picsa/capacitor-resumable-download.git"
  },
  "bugs": {
    "url": "https://github.com/e-picsa/capacitor-resumable-download/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "download",
    "resumable",
    "http-range",
    "workmanager",
    "android"
  ],
  "scripts": {
    "verify:cdn": "node scripts/verify-cdn.mjs",
    "serve:test-file": "node scripts/serve-test-file.mjs",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "demo:sync": "yarn build && yarn sync:plugin && cd example-app && yarn build && npx cap sync android",
    "demo:build": "yarn demo:sync && node scripts/sync-plugin.mjs --check && cd example-app/android && ./gradlew assembleDebug",
    "demo:install": "adb install -r example-app/android/app/build/outputs/apk/debug/app-debug.apk",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "build:types": "tsc",
    "build:bundle": "rollup -c rollup.config.mjs",
    "build": "yarn clean && yarn build:types && yarn build:bundle",
    "test:android": "cd android && ./gradlew test",
    "test": "yarn test:android",
    "lint:android": "cd android && ./gradlew :lintDebug",
    "fmt": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
    "lint": "prettier --check \"**/*.{ts,js,mjs,json,md}\"",
    "prepublishOnly": "yarn build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "// peerDependencies": "Retain both ^8.0.0 and ^9.0.0 for dual compatibility with Capacitor 8 and 9 host apps. Do not overwrite with >=9.0.0.",
  "peerDependencies": {
    "@capacitor/core": "^8.0.0 || ^9.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.6",
    "typescript": "^5.4.0"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  }
}
